disable=SC2034   # the scripts that source lib/shell/common.sh read its constants and the STEP and STEP_TOTAL counters
disable=SC1091   # scripts source common.sh through "${SCRIPT_DIR}/common.sh", which shellcheck cannot follow, even with -x
disable=SC2015   # `cond && ok || err` is this repo's reporting idiom
disable=SC2016   # sh -c and kubectl exec get single-quoted bodies that must not expand locally
