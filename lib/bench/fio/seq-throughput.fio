# Measures the bandwidth ceiling of each arm. It explains a latency result, but never decides it.
# On the Longhorn arms it shows the throughput cap of the link: 1GbE here, with TSO, GSO and GRO off.

[global]
filename=/data/fio-seq
ioengine=libaio
direct=1
rw=write
bs=1m
iodepth=16
size=2g
numjobs=1
time_based=1
ramp_time=5
runtime=30
group_reporting=1

[seq]
