# wal-fsync with one committer per core. Group commit is the best case for Longhorn.
# If concurrency spreads the replication cost of each operation, the serial result overstates the real cost.

[global]
filename=/data/fio-wal-gc
ioengine=psync
direct=0
fdatasync=1
rw=write
bs=8k
size=512m
numjobs=4             # a Pi 5 has 4 cores
iodepth=1
time_based=1
ramp_time=10
runtime=60
group_reporting=1
percentile_list=50:95:99:99.9:100

[wal-gc]
