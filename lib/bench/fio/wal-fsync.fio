# Serial write then fdatasync, like the Postgres WAL writer and the RabbitMQ Ra log.
# This is the main result. On Longhorn every fdatasync waits for the second replica over the network.

[global]
filename=/data/fio-wal
ioengine=psync        # WAL and Ra sync serially. libaio would measure the drive queue, which neither uses.
direct=0              # Postgres opens WAL without O_DIRECT under the default wal_sync_method
fdatasync=1
rw=write              # WAL and Raft logs are append-only
bs=8k                 # Postgres wal_block_size
size=512m
numjobs=1
iodepth=1
time_based=1
ramp_time=10
runtime=60
group_reporting=1
percentile_list=50:95:99:99.9:100

[wal]
