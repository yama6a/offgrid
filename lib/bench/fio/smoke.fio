# For --smoke only. It has the shape of wal-fsync but runs for seconds, not minutes.
# It proves that the PVC mounts, fio runs and the JSON parses. Its numbers mean nothing, and --smoke marks the run so.

[global]
filename=/data/fio-smoke
ioengine=psync
direct=0
fdatasync=1
rw=write
bs=8k
size=32m
numjobs=1
iodepth=1
time_based=1
ramp_time=1
runtime=5
group_reporting=1
percentile_list=50:95:99:99.9:100

[smoke]
