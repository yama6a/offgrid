# Local Terraform state holds the generated IAM secret key. The repo is public, so never commit it.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Provider plugins and the local working dir. The committed .terraform.lock.hcl reproduces them.
.terraform/
.terraform.tfstate.lock.info

# A *.tfvars file would hold real values. The values come from .env as TF_VAR_*, so none should exist. The
# ignore stops a stray one from leaking.
*.tfvars
*.tfvars.json

# *.tf and .terraform.lock.hcl stay committed. The lock file is the provider version pin and holds no secret.
