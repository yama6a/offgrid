# Template for per-deployment config and secrets. Copy it to .env and edit:  cp .env.example .env
# Plain KEY=value scalars only. No logic, arrays or command substitution. Chart versions live in each chart's
# Chart.yaml, not here.
# The IPs, domains, emails and repo below are fake placeholders. Every secret is empty on purpose. Leave one
# empty to skip the feature it enables, and never put a real secret in this committed template.

# ---- CONFIG: per-deployment values, not secret ----

# ---- Cluster shape: what this platform assumes about the machines under it ----
# This repo does not build the cluster. Nodes, networking and OS are whatever you already run. The repo starts
# from a kubectl context that points at a cluster that already exists.
# The defaults below describe a Talos cluster, the cluster this repo was developed against. Each one is a real
# assumption. The README section "What this expects of your cluster" says what to change if yours differs.
KUBE_API_HOST="localhost"              # where Cilium reaches the API before pod networking exists. On Talos this is KubePrism on localhost. Elsewhere use your API endpoint or a node-local proxy
KUBE_API_PORT="7445"                   # port for KUBE_API_HOST. Talos KubePrism uses 7445, a plain apiserver usually 6443
KUBELET_TLS_INSECURE="true"            # true makes metrics-server skip kubelet cert checks, for self-signed kubelet certs with no CSR approver. Set false if your kubelets have signed certs
ETCD_METRICS_PORT="2381"               # etcd's metrics listener, scraped for the control-plane dashboards. Minimal clusters may not expose it
LONGHORN_DATA_PATH="/var/mnt/storage"  # where Longhorn stores replica data on each node. Longhorn's own default is /var/lib/longhorn. Any path works if it exists on every Longhorn node and is bind-mounted rshared into the kubelet

# ---- Target cluster: the safety interlock, read this one ----
# The one kubectl context that every script here may touch. Your ~/.kube/config likely holds work clusters
# too, and these scripts are not read-only. The DANGEROUS_ scripts redeliver a whole platform and wipe S3
# backups. So the target is pinned here, and never taken from the selected context.
# Leave it empty and the first run lists your contexts, asks once, and writes the answer into .env.
KUBE_CONTEXT=""                        # for example admin@my-cluster

# ---- GHCR registry: private image pulls ----
GHCR_USER="your-github-username"       # GitHub user that owns the pull token. Also your GHCR namespace

# ---- GitOps and Argo CD: steps 02a and 02b ----
# REPO_URL must equal the repoURL committed in argo_apps/, in https form with no trailing .git.
REPO_URL="https://github.com/yama6a/offgrid"
POLL_SYNC_ENABLED="false"              # Argo CD git poll interval, which 02b writes into timeout.reconciliation. false is a 300s fallback, true is 60s. The webhook is the fast path either way. 02b generates the webhook secret into secrets/, so it is not here

# ---- Networking and domains: step 01 Cilium LB-IPAM, step 04_values gateway values ----
LB_RANGE_START="192.168.100.200"       # first IP of the CiliumLoadBalancerIPPool. Same L2 as the nodes, outside DHCP
LB_RANGE_STOP="192.168.100.250"        # last IP of the pool
INGRESS_LB_IP="192.168.100.200"        # the one IP every ingress answers on. Must be between LB_RANGE_START and LB_RANGE_STOP
BASE_DOMAIN="example.com"              # required. A registrable domain you own. Platform UIs go on *.ops.<base>, workloads on *.app.<base>
SSO_ALLOWLIST="you@example.com"        # space-separated Google accounts that may pass the SSO gate on every protected host
LE_EMAIL="you@example.com"             # ACME registration email for the Let's Encrypt ClusterIssuers
CLOUDFLARE_WILDCARD_DOMAINS=""         # space-separated host tiers or whole domains that get Cloudflare DNS-01 wildcard certs, for example "ops.example.com app.example.com example.edu". Entries need not be under BASE_DOMAIN. Cloudflare detects the registrable zone. Empty uses HTTP-01 per host

# ---- S3 backups: the Terraform bucket, then the CNPG, Redis, Longhorn and VictoriaMetrics/Logs backups, steps 10a to 10e ----
AWS_REGION="eu-central-1"              # AWS region of the backup bucket, for Terraform and the CNPG S3 endpoint
S3_BACKUP_BUCKET="my-cluster-backups"  # globally unique bucket for all backups, with the prefixes cnpg/, redis/, longhorn/ and vm/
S3_BACKUP_TRANSITION_DAYS="30"         # lifecycle: age in days at which objects move to Glacier Instant Retrieval
S3_BACKUP_RETENTION_DAYS="180"         # lifecycle: age in days at which objects are deleted. This is the recovery window
CNPG_BACKUP_RPO="15min"                # WAL archive_timeout, as a Postgres duration string. A primary failure loses at most this much committed data

# ---- SECRETS: never commit or share. An empty value skips its feature. ----

GITHUB_GHCR_PULL_TOKEN_SECRET=""       # classic PAT with read:packages, to pull private ghcr.io images. Used here only for a docker login. Cluster-wide pull auth is a node-level setting. Empty allows public images only
ARGOCD_GITHUB_PAT_SECRET=""            # fine-grained, read-only PAT for this one repo. 02a seeds Argo CD's repo-creds Secret with it. Empty clones anonymously, which works for a public repo only
GOOGLE_SSO_CLIENT_ID=""                # Google OAuth client ID (*.apps.googleusercontent.com). 04_google_sso writes it into the google-sso values. Required for SSO
GOOGLE_SSO_CLIENT_SECRET=""            # Google OAuth client secret for GOOGLE_SSO_CLIENT_ID. 04_google_sso seals it for Envoy Gateway OIDC. Required for SSO
CLOUDFLARE_API_TOKEN_SECRET=""         # scoped Cloudflare API token with Zone:DNS:Edit and Zone:Read on every parent zone of CLOUDFLARE_WILDCARD_DOMAINS. 04_cloudflare_token seals it into cert-manager for DNS-01 wildcard certs. Empty turns DNS-01 off, and every host falls back to HTTP-01
NTFY_PHONE_PASSWORD_SECRET=""          # password of the ntfy 'phone' user, the Android app login. 06_ntfy_auth seeds it. Empty turns ntfy alerting off
AWS_DEPLOY_ACCESS_KEY_ID=""            # AWS deployer access key ID, for Terraform only. It needs s3:* on the bucket and iam:* on the writer. The exact policy is in docs/10_backups.md. Empty skips backups, and 10a to 10e do nothing. Never sealed into the cluster
AWS_DEPLOY_SECRET_ACCESS_KEY_SECRET="" # AWS deployer secret access key, for Terraform only. Never enters the cluster
