# The committed version recipe, sourced by lib/shell/common.sh alongside the gitignored .env.
# To bump: edit here, or let renovate do it (renovate.json5 customManagers).

## Capped by the pinned Talos release's k8s default; raising it past that makes upgrade-k8s reject it.
# renovate: datasource=github-releases depName=kubernetes/kubernetes
KUBERNETES_VERSION="1.36.3"

## Also the talosctl client and the expected server version.
# renovate: datasource=github-releases depName=siderolabs/talos
TALOS_VERSION="v1.13.7"

# renovate: datasource=github-releases depName=talos-rpi5/talos-builder
BUILDER_VERSION="v1.11.5"

## A bare commit SHA: the repo has no tags. Renovated by a custom manager.
SBCOVERLAY_VERSION="7d04484be2beb4b1fca56538d2b6d07e7d58681f"

## Digest-pinned system extensions for this Talos version.
# renovate: datasource=docker
ISCSI_EXT="ghcr.io/siderolabs/iscsi-tools:v0.2.0@sha256:cfae92aea17c3ce5afc26723e945160922c577dc27b9525b1b330c4a2f929820"
# renovate: datasource=docker
UTIL_EXT="ghcr.io/siderolabs/util-linux-tools:2.42.2@sha256:e78c9ea7070a639813c9561f6050c44117e5f63eb39cd201c4b49a8c54f112b4"
