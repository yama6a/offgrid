          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "kubernetes.pod_namespace:crowdsec kubernetes.container_name:crowdsec-lapi crowdsec_alert:=ban -scenario:=\"test alert\" | stats by (ip) count() bans, max(country) country, max(as_name) as_owner, max(as_number) as_number, uniq_values(scenario) scenarios, max(_time) last_seen | sort by (bans desc) | limit 100",
          "queryType": "instant"
        }
      ]
    },
    {
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": true,
            "keepTime": true
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Time": 0,
              ":authority": 1,
              "method": 2,
              "x-envoy-origin-path": 3,
              "response_code": 4,
              "user-agent": 5
            },
            "excludeByName": {},
            "renameByName": {}
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Time",
                ":authority",
