                "user-agent"
              ]
            }
          }
        }
      ],
      "type": "table",
      "title": "Requests from $ip",
      "id": 8,
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "description": "The Envoy requests of the IP in the `ip` box at the top, newest first, at most 500. Click an IP in the table above to fill the box. Empty while the box is empty.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "kubernetes.pod_namespace:envoy-gateway-system kubernetes.container_name:envoy | extract_regexp \"^[[]?(?P<client_ip>[0-9A-Fa-f.:]+?)[]]?:[0-9]+$\" from downstream_remote_address | filter client_ip:=\"$ip\" | fields _time, :authority, method, x-envoy-origin-path, response_code, user-agent | sort by (_time desc) | limit 500",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "row",
      "title": "Pipeline health",
      "id": 9,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Envoy lines per second",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Lines the agent read from the Envoy pods, and how many the local parser took. Envoy lines with an empty host, such as HTTP codec errors, never parse. So watch the not-parsed share for a change, not for zero.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(rate(cs_kubernetessource_hits_total{namespace=\"crowdsec\"}[$__rate_interval]))",
          "legendFormat": "read"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(rate(cs_parser_hits_ok_total{namespace=\"crowdsec\", type=\"kubernetes\"}[$__rate_interval]))",
          "legendFormat": "parsed"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(rate(cs_parser_hits_ko_total{namespace=\"crowdsec\", type=\"kubernetes\"}[$__rate_interval]))",
          "legendFormat": "not parsed"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Events whitelisted per second",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Events a whitelist dropped, per whitelist. local/never-ban covers private ranges, the own public IP and CCBot. The hub whitelists cover Google and Bing by reverse DNS, CDNs and public DNS resolvers.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 45
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (name) (rate(cs_node_wl_hits_ok_total{namespace=\"crowdsec\"}[$__rate_interval]))",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
