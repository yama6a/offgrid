          },
          "expr": "kubernetes.pod_namespace:crowdsec kubernetes.container_name:crawler-allowlist \"download failed or empty\" | extract \"crawler-allowlist: <source>: download\" | stats by (source) count() failures, max(_time) last_failure | sort by (failures desc)",
