        }
      ],
      "type": "table",
      "title": "Crawler allowlist refreshes",
      "id": 12,
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "description": "One row per run of the crawler-allowlist sidecar, at start and every 24h. Failures count the sources that failed. Those keep their entries from the last good run.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 53
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "kubernetes.pod_namespace:crowdsec kubernetes.container_name:crawler-allowlist \"done:\" | extract \"done: <entries> entries, <added> added, <removed> removed, <failures> failures\" | fields _time, entries, added, removed, failures | sort by (_time desc)",
          "queryType": "instant"
        }
      ]
    },
    {
      "transformations": [
