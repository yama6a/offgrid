              "options": "ip"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show the requests from this IP",
                    "url": "/d/crowdsec/crowdsec?var-ip=${__value.raw}&${__url_time_range}"
                  },
                  {
                    "title": "Open the requests in Explore",
                    "url": "",
                    "internal": {
                      "datasourceUid": "VictoriaLogs",
