{
  "uid": "crowdsec",
  "title": "CrowdSec",
  "tags": [
    "crowdsec",
    "envoy",
    "ingress"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "ip",
        "label": "IP",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "A source IP. Fills the requests table."
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Would-be bans",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Would-be bans",
      "id": 2,
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "description": "Alerts that carry a ban decision. LAPI writes one JSON line per such alert to its log, after every whitelist and the crawler allowlist. During the audit each one is a simulated ban.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "kubernetes.pod_namespace:crowdsec kubernetes.container_name:crowdsec-lapi crowdsec_alert:=ban -scenario:=\"test alert\" | stats count()",
          "queryType": "stats"
        }
      ]
    },
    {
      "type": "stat",
      "title": "IPs that would be banned",
      "id": 3,
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "description": "Distinct source IPs with at least one would-be ban in the time range.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "kubernetes.pod_namespace:crowdsec kubernetes.container_name:crowdsec-lapi crowdsec_alert:=ban -scenario:=\"test alert\" | stats count_uniq(ip)",
          "queryType": "stats"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Alerts dropped by the crawler allowlist",
      "id": 4,
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "description": "Alerts from an IP on the crawlers allowlist. LAPI drops them before it stores anything. A rise here means a crawler tripped a scenario.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "kubernetes.pod_namespace:crowdsec kubernetes.container_name:crowdsec-lapi \"is allowlisted\" | stats count()",
          "queryType": "stats"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Would-be bans per scenario",
      "id": 5,
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "description": "One bar per would-be ban, stacked by scenario.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "kubernetes.pod_namespace:crowdsec kubernetes.container_name:crowdsec-lapi crowdsec_alert:=ban -scenario:=\"test alert\" | stats by (scenario) count()",
          "queryType": "statsRange",
          "legendFormat": "{{scenario}}"
        }
      ]
    },
    {
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": true,
            "keepTime": true
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "ip": 0,
              "bans": 1,
              "country": 2,
              "as_owner": 3,
              "as_number": 4,
              "scenarios": 5,
              "last_seen": 6
            },
            "excludeByName": {},
            "renameByName": {}
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "ip",
                "bans",
                "country",
                "as_owner",
                "as_number",
                "scenarios",
                "last_seen"
              ]
            }
          }
        }
      ],
      "type": "table",
      "title": "Would be banned right now",
      "id": 6,
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "description": "IPs whose last would-be ban is under 4h old, the ban duration in profiles.yaml of 03_crowdsec. The panel always covers the last 4h, whatever the dashboard range. During the audit nothing is blocked. After blocking starts, `cscli decisions list` holds the real bans.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ip"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show the requests from this IP",
                    "url": "/d/crowdsec/crowdsec?var-ip=${__value.raw}&${__url_time_range}"
                  },
                  {
                    "title": "Open the requests in Explore",
                    "url": "",
                    "internal": {
                      "datasourceUid": "VictoriaLogs",
                      "datasourceName": "VictoriaLogs",
                      "query": {
                        "refId": "A",
                        "queryType": "instant",
                        "expr": "kubernetes.pod_namespace:envoy-gateway-system kubernetes.container_name:envoy | extract_regexp \"^[[]?(?P<client_ip>[0-9A-Fa-f.:]+?)[]]?:[0-9]+$\" from downstream_remote_address | filter client_ip:=\"${__value.raw}\" | copy \":authority\" as host | format \"<response_code> <method> <host><x-envoy-origin-path> ua=<q:user-agent>\" as _msg"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "bans",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "kubernetes.pod_namespace:crowdsec kubernetes.container_name:crowdsec-lapi crowdsec_alert:=ban -scenario:=\"test alert\" | stats by (ip) count() bans, max(country) country, max(as_name) as_owner, max(as_number) as_number, uniq_values(scenario) scenarios, max(_time) last_seen | sort by (bans desc) | limit 100",
          "queryType": "instant"
        }
      ],
      "timeFrom": "4h"
    },
    {
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": true,
            "keepTime": true
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "ip": 0,
              "bans": 1,
              "country": 2,
              "as_owner": 3,
              "as_number": 4,
              "scenarios": 5,
              "last_seen": 6
            },
            "excludeByName": {},
            "renameByName": {}
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "ip",
                "bans",
                "country",
                "as_owner",
                "as_number",
                "scenarios",
                "last_seen"
              ]
            }
          }
        }
      ],
      "type": "table",
      "title": "IPs that would be banned",
      "id": 7,
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "description": "Top 100 source IPs by would-be bans. Country and AS come from CrowdSec's offline GeoIP database. Click an IP to list its requests below, or to open them in Explore.",
      "gridPos": {
        "h": 10,
        "w": 24,
