                      "query": {
                        "refId": "A",
                        "queryType": "instant",
                        "expr": "kubernetes.pod_namespace:envoy-gateway-system kubernetes.container_name:envoy | extract_regexp \"^[[]?(?P<client_ip>[0-9A-Fa-f.:]+?)[]]?:[0-9]+$\" from downstream_remote_address | filter client_ip:=\"${__value.raw}\" | copy \":authority\" as host | format \"<response_code> <method> <host><x-envoy-origin-path> ua=<q:user-agent>\" as _msg"
                      }
                    }
                  }
                ]
