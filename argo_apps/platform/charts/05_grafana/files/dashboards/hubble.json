{
  "uid": "hubble",
  "title": "Hubble",
  "description": "Cilium flow observability: verdicts, drops, per-namespace talkers, TCP/ICMP health and DNS.",
  "tags": [
    "cilium",
    "hubble",
    "network"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "definition": "label_values(hubble_flows_processed_total, node)",
        "query": {
          "qryType": 1,
          "query": "label_values(hubble_flows_processed_total, node)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "description": "Which cilium-agent's view to chart. An agent only reports the flows it saw itself.",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "definition": "label_values(hubble_flows_processed_total, source_namespace)",
        "query": {
          "qryType": 1,
          "query": "label_values(hubble_flows_processed_total, source_namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "description": "Scopes the Namespace row. Populated by the labelsContext options set in 00_cilium values.",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
