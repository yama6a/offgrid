{
  "uid": "ingress-http",
  "title": "Ingress HTTP",
  "description": "HTTP at the Envoy Gateway edge: per-HTTPRoute rate, errors and latency, backend health, and the Google SSO handshake.",
  "tags": [
    "envoy",
    "gateway",
    "ingress"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "definition": "label_values(envoy_cluster_membership_healthy{envoy_cluster_name=~\"httproute/.+\"}, envoy_cluster_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(envoy_cluster_membership_healthy{envoy_cluster_name=~\"httproute/.+\"}, envoy_cluster_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "description": "One entry per HTTPRoute rule, named httproute/<namespace>/<name>/rule/<n>. Read from cluster membership, not from a request counter, so routes that have served nothing still appear.",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Requests/s",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(rate(envoy_cluster_upstream_rq_total{envoy_cluster_name=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "Requests/s"
        }
      ]
    },
    {
      "type": "stat",
      "title": "5xx",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "100 * (sum(rate(envoy_cluster_upstream_rq_xx{envoy_cluster_name=~\"$route\", envoy_response_code_class=\"5\"}[$__rate_interval])) or vector(0))\n/\nsum(rate(envoy_cluster_upstream_rq_total{envoy_cluster_name=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        }
      ],
      "description": "`or vector(0)` so a window with zero 5xx reads 0% instead of going blank. Still blank when no request was served at all, because then the ratio really is 0/0: the ingress-http alert group carries a 0.2 req/s floor for the same reason."
    },
    {
      "type": "stat",
      "title": "Upstream p95",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
