          "expr": "100 * (sum by (route) (label_replace(rate(envoy_cluster_upstream_rq_xx{envoy_cluster_name=~\"$route\", envoy_response_code_class=\"5\"}[$__rate_interval]), \"route\", \"$1\", \"envoy_cluster_name\", \"httproute/[^/]+/([^/]+)/rule/.*\")) or 0 * sum by (route) (label_replace(rate(envoy_cluster_upstream_rq_total{envoy_cluster_name=~\"$route\"}[$__rate_interval]), \"route\", \"$1\", \"envoy_cluster_name\", \"httproute/[^/]+/([^/]+)/rule/.*\")))\n/\nsum by (route) (label_replace(rate(envoy_cluster_upstream_rq_total{envoy_cluster_name=~\"$route\"}[$__rate_interval]), \"route\", \"$1\", \"envoy_cluster_name\", \"httproute/[^/]+/([^/]+)/rule/.*\"))",
          "legendFormat": "{{route}}"
