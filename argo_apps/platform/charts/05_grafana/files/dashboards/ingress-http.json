      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "count(sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_rq_total{envoy_cluster_name=~\"$route\"}[$__rate_interval])) > 0)",
          "legendFormat": "routes"
        }
      ],
      "description": "Envoy creates a route's request counters on its FIRST request, so an idle route is missing here rather than zero. Compare against the route dropdown, which is built from cluster membership and lists every configured route."
    },
    {
