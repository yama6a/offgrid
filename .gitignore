# Per-deployment config and secrets. Copy the template:  cp .env.example .env
.env
.env.bak
.env.bak.*

# The sealed-secrets master key and the webhook secret. `secrets/` is a symlink to a store outside the repo.
/secrets

/.cache/

# Listed here, not in a personal global gitignore, so a fork on another machine does not commit them.
.idea/
.vscode/
.DS_Store
__pycache__/

# Packaged Helm dependencies. Chart.yaml and any committed Chart.lock reproduce them.
**/charts/*.tgz

# A lock on file://-only deps pins nothing and breaks Argo CD's build once it drifts. Charts with a remote dep
# commit their lock, so this lists the file://-only charts by path.
argo_apps/platform/charts/04_google_sso/Chart.lock
argo_apps/platform/charts/06_platform_ingress/Chart.lock
argo_apps/workloads/charts/*/Chart.lock
