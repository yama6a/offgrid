{
  // Renovate config. Opens dependency-update PRs for EVERY pin in the repo:
  //  - helm chart deps (Chart.yaml + Chart.lock + vendored charts/*.tgz)   -> helmv3
  //  - container images in values.yaml (single-string + repository/tag)     -> helm-values
  //  - the aws terraform provider (versions.tf + .terraform.lock.hcl)       -> terraform
  //  - the renovate workflow's own action pins                              -> github-actions
  //  - images in chart templates + shell scripts, and versions.env          -> customManagers (regex)
  //    Talos/kernel build recipe
  // Cadence is the GHA cron (every 3h — frequent so Renovate can self-merge the combined PR; see below). No
  // internal `schedule`, so a manual workflow_dispatch works too.
  // Run self-hosted by .github/workflows/renovate.yaml. Docs: docs/14_renovate.md.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":dependencyDashboard", // one issue listing every pending/failed update (needs repo Issues enabled)
    "helpers:pinGitHubActionDigestsToSemver", // action pins carry a readable version alongside the digest
  ],
  prConcurrentLimit: 12,
  prHourlyLimit: 0, // no hourly throttle
  dependencyDashboardTitle: "Renovate dependency dashboard",

  // Automerge via Renovate ITSELF, not GitHub's native auto-merge. Renovate merges the PR through the API
  // once it's mergeable — which NOW means after the required CI checks pass (.github/workflows/ci.yaml):
  // Renovate waits on a PR's checks by default, and branch protection enforces them on the API merge too. So
  // the combined PR merges on a SUBSEQUENT run once CI is green (~2h+ after creation) — which is why the GHA
  // cron runs every 3h, not weekly. (platformAutomerge stays false: keep Renovate's own API merge.)
  platformAutomerge: false,

  // helmv3 auto-discovers every Chart.yaml and refreshes each wrapper's Chart.lock on a bump. NO chart commits
  // charts/*.tgz anymore (every wrapper either gitignores the fetched blob or, like pg-cluster/redis-instance,
  // renders CRs directly with no upstream dep) — so helmUpdateSubChartArchives is currently a no-op; kept as a
  // harmless guard in case a vendored tarball is ever reintroduced. file:// deps have no datasource so Renovate
  // skips them. NOTE: do NOT add a "**/charts/**" disable rule — the wrapper charts themselves live under paths
  // containing /charts/, so that would disable the whole repo.
  postUpdateOptions: ["helmUpdateSubChartArchives"],

  // Bumping this file re-vendors an upstream release manifest verbatim (per its README curl recipe), not a
  // line edit — never let a bot patch the image tag inside it.
  ignorePaths: ["argo_apps/platform/charts/03_barman_cloud_plugin/templates/**"],

  customManagers: [
    {
      // Container images annotated `# renovate: datasource=docker` in files helm-values can't read: chart
      // templates (redis-instance's exporter), shell-script literals, and the versions.env system extensions.
      // (Images in values.yaml are handled by helm-values or the datastore-version manager below, NOT here, to
      // avoid double-managing.) Captures repo:tag(+@sha256 digest) from the ref itself, so tag AND digest stay fresh.
      customType: "regex",
      description: "docker image refs (annotated) in chart templates, shell scripts, versions.env",
      managerFilePatterns: [
        "/^versions\\.env$/",
        "/^lib/shell/.*\\.sh$/",
        "/^lib/helm/redis-instance/templates/redis\\.yaml$/", // the redis-exporter ref (the server tag is now per-workload)
        "/^argo_apps/platform/charts/07_redis_backup/templates/cronjob\\.yaml$/", // alpine/k8s + opstree-redis refs
      ],
      matchStrings: [
        "# renovate: datasource=docker(?: versioning=(?<versioning>\\S+))?\\s+[^\\n]*?(?<depName>[a-z0-9][a-z0-9._/-]+):(?<currentValue>[\\w][\\w.-]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?",
      ],
      datasourceTemplate: "docker",
    },
    {
      // Per-workload datastore versions: a bare `postgresVersion`/`redisVersion` scalar in a workload's
      // values.yaml, with the repo named in the `depName=` annotation (the tag alone has no repo). Each workload
      // owns its own major. redisVersion tracks all update types (patch+minor+major); postgresVersion is held to
      // MAJOR-only by a packageRule below (patch/minor come from the chart's digest-pinned image map instead), so
      // Renovate surfaces a per-workload PG major upgrade (18->19) for review. See docs/14_renovate.md.
      customType: "regex",
      description: "per-workload datastore image tags (annotated postgresVersion/redisVersion in workload values.yaml)",
      managerFilePatterns: ["/^argo_apps/workloads/charts/[^/]+/values\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=docker depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+(?:postgresVersion|redisVersion):\\s*\"?(?<currentValue>[\\w][\\w.-]*)\"?",
      ],
      datasourceTemplate: "docker",
    },
    {
      // pg-cluster's supported Postgres image map (lib/helm/pg-cluster/files/postgres-images.yaml): one pinned
      // `<repo>:<tag>@<digest>` per supported major. Digest-only (the packageRule below disables tag bumps):
      // Renovate refreshes each digest as the rolling <major>-minimal-trixie tag moves onto a new patch build.
      // Adding/removing a major is a manual edit (a new PG major is a pg_upgrade, not a digest swap).
      customType: "regex",
      description: "pg-cluster supported Postgres images (tag@digest per major)",
      managerFilePatterns: ["/^lib/helm/pg-cluster/files/postgres-images\\.yaml$/"],
      matchStrings: [
        "(?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>[\\w][\\w.-]*)@(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      datasourceTemplate: "docker",
    },
    {
      // Scalar version vars in versions.env carrying a full `# renovate: datasource=... depName=...` comment
      // (Talos / pkgs / talos-builder / kernel / kubernetes). SBCOVERLAY is handled separately below.
      customType: "regex",
      description: "annotated version scalars in versions.env",
      managerFilePatterns: ["/^versions\\.env$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+\\w+=\"(?<currentValue>[^\"]+)\"",
      ],
    },
    {
      // The sbc-raspberrypi5 overlay is pinned to a bare commit SHA (the repo has no tags); 03a clones `main`
      // then checks out this SHA. Track main's HEAD and keep the SHA fresh via git-refs.
      customType: "regex",
      description: "sbc-raspberrypi5 overlay commit pin",
      managerFilePatterns: ["/^versions\\.env$/"],
      matchStrings: ["SBCOVERLAY_VERSION=\"(?<currentDigest>[a-f0-9]{40})\""],
      currentValueTemplate: "main",
      depNameTemplate: "talos-rpi5/sbc-raspberrypi5",
      packageNameTemplate: "https://github.com/talos-rpi5/sbc-raspberrypi5",
      datasourceTemplate: "git-refs",
    },
    // NB: no kernel manager. The kernel isn't pinned — 03a derives the raspberrypi/linux commit from the version
    // Talos expects (machinery DefaultKernelVersion) at build time. Bumping TALOS_VERSION (handled by the annotated
    // scalar manager above) carries the kernel with it. See docs/03 "The kernel version must match Talos".
  ],

  packageRules: [
    {
      // ONE combined, AUTO-MERGED PR for every NON-major update (minor + patch + digest + pin + lockfile).
      // Renovate self-merges it once mergeable, now GATED on the required CI checks (green before merge; ~2h+ after creation). WARNING: a merged bump still reaches the live
      // cluster unattended via ArgoCD self-heal — including Cilium (which can cut the cluster off its own
      // network) and any local-path tag bump (which really needs a manual re-vendor, see below); it also bumps
      // the Talos/kernel versions.env recipe, which a merge does NOT apply (that needs a manual rebuild — 03a). Accepted
      // trade-off for a hands-off homelab. To de-risk later: add `minimumReleaseAge` so bumps bake first, or
      // drop `automerge` from the deps you want to gate. See docs/14_renovate.md.
      description: "combine all non-major updates into one auto-merged PR",
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "lockFileMaintenance"],
      groupName: "all non-major dependencies",
      automerge: true,
    },
    // MAJOR updates get their own PR each (Renovate default) — a breaking bump is reviewed in isolation, never
    // bundled. The VictoriaMetrics charts are the one exception: their CRDs must match the operator, so their
    // majors are kept together in a single PR.
    {
      description: "keep VictoriaMetrics majors together (CRDs must match the operator)",
      matchPackageNames: ["victoria-metrics-operator", "victoria-metrics-operator-crds", "victoria-metrics-k8s-stack", "victoria-logs-collector"],
      matchUpdateTypes: ["major"],
      groupName: "victoriametrics stack (major)",
    },
    {
      // k8s release tags are v-prefixed; the versions.env value is not. Strip the v when comparing.
      description: "kubernetes tags are v-prefixed",
      matchPackageNames: ["kubernetes/kubernetes"],
      extractVersion: "^v(?<version>.+)$",
    },
    {
      // local-path-provisioner ships as VENDORED upstream manifests keyed to values.image.tag — a bump must be
      // re-diffed against the upstream release by hand. Label it so, if it changed, you split it out of the
      // combined PR and re-vendor before merging. busybox is its helper image, same chart, same treatment.
      description: "needs-revendor: local-path-provisioner",
      matchManagers: ["helm-values"],
      matchFileNames: ["argo_apps/platform/charts/02_local_path_provisioner/values.yaml"],
      addLabels: ["needs-revendor"],
    },
    {
      // Pin the workflow's action refs to commit digests (supply-chain hardening); the semver-comment helper
      // above keeps a readable version beside each digest.
      description: "pin github action refs to digests",
      matchManagers: ["github-actions"],
      pinDigests: true,
    },
    {
      // Per-workload `postgresVersion` is a MAJOR selector only (a key into pg-cluster's image map); the actual
      // patch/digest is pinned and tracked in that map. Disable patch/minor/digest here so the workload scalar
      // never churns on a patch. Only a PG MAJOR bump (18 to 19) surfaces, as its own reviewed (non-automerged)
      // PR. It fails CI until the matching major is added to files/postgres-images.yaml (the deliberate pg_upgrade
      // gate). See lib/helm/pg-cluster + docs/14_renovate.md.
      description: "workload postgresVersion: major-only (patch/minor come from the pg-cluster image map)",
      matchFileNames: ["argo_apps/workloads/charts/**/values.yaml"],
      matchDepNames: ["ghcr.io/cloudnative-pg/postgresql"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      enabled: false,
    },
    {
      // The pg-cluster image map is DIGEST-ONLY: each line stays on its major's rolling <major>-minimal-trixie
      // tag forever and Renovate just refreshes the digest as that tag moves onto new patch builds. Disable tag
      // version bumps so 18-minimal-trixie is never auto-rewritten to a 19 tag. A new PG major is added by hand
      // (a pg_upgrade, not a swap). See lib/helm/pg-cluster/files/postgres-images.yaml.
      description: "pg-cluster image map: digest-only, no tag version bumps",
      matchFileNames: ["lib/helm/pg-cluster/files/postgres-images.yaml"],
      matchUpdateTypes: ["major", "minor", "patch"],
      enabled: false,
    },
  ],
}
