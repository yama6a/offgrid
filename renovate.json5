{
  // Opens dependency-update PRs for every pin in the repo. Which manager owns what:
  //   helmv3          chart deps (Chart.yaml + Chart.lock)
  //   helm-values     container images in values.yaml
  //   terraform       the aws provider (versions.tf + .terraform.lock.hcl)
  //   github-actions  the renovate workflow's own action pins
  //   customManagers  images in chart templates + shell scripts, and the versions.env pins
  // Cadence is the cron in .github/workflows/renovate.yaml, not an internal `schedule`, so a manual
  // workflow_dispatch works too. Docs: docs/14_renovate.md.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":dependencyDashboard", // one issue listing every pending/failed update (needs repo Issues enabled)
    "helpers:pinGitHubActionDigestsToSemver", // action pins carry a readable version alongside the digest
  ],
  prConcurrentLimit: 12,
  prHourlyLimit: 0, // no hourly throttle
  dependencyDashboardTitle: "Renovate dependency dashboard",

  // Automerge through Renovate's own API call, not GitHub's native auto-merge. Renovate waits for a PR's
  // required CI checks by default, and branch protection enforces them on the merge call too, so the combined
  // PR lands on a LATER run once CI is green (~2h+ after it was opened). That is why the cron runs every 3h
  // rather than weekly. platformAutomerge stays false to keep the merge on Renovate's side.
  platformAutomerge: false,

  // helmv3 auto-discovers every Chart.yaml and refreshes each wrapper's Chart.lock on a bump. file:// deps
  // have no datasource, so Renovate skips them.
  // helmUpdateSubChartArchives re-packs a vendored charts/*.tgz. No chart commits one today, so it does
  // nothing; kept as a guard in case one is reintroduced.
  // Do NOT add a "**/charts/**" disable rule: the wrapper charts themselves live under paths containing
  // /charts/, so that would disable the whole repo.
  postUpdateOptions: ["helmUpdateSubChartArchives"],

  // Bumping this file re-vendors an upstream release manifest verbatim, per its README curl recipe. Never
  // let a bot patch the image tag inside it.
  ignorePaths: ["argo_apps/platform/charts/03_barman_cloud_plugin/templates/**"],

  customManagers: [
    {
      // Images annotated `# renovate: datasource=docker` in files helm-values cannot read: chart templates,
      // shell-script literals, and the versions.env extensions. Images in values.yaml are handled by
      // helm-values or the manager below instead, to avoid double-managing.
      // Captures repo:tag(+digest) from the ref itself, so tag AND digest stay fresh.
      customType: "regex",
      description: "docker image refs (annotated) in chart templates, shell scripts, versions.env",
      managerFilePatterns: [
        "/^versions\\.env$/",
        "/^lib/shell/.*\\.sh$/",
        "/^lib/helm/redis-instance/templates/redis\\.yaml$/", // the redis-exporter ref (the server tag is now per-workload)
        "/^argo_apps/platform/charts/07_redis_backup/templates/cronjob\\.yaml$/", // alpine/k8s + opstree-redis refs
      ],
      matchStrings: [
        "# renovate: datasource=docker(?: versioning=(?<versioning>\\S+))?\\s+[^\\n]*?(?<depName>[a-z0-9][a-z0-9._/-]+):(?<currentValue>[\\w][\\w.-]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?",
      ],
      datasourceTemplate: "docker",
    },
    {
      // A bare postgresVersion/redisVersion scalar in a workload's values.yaml, with the repo named in the
      // depName= annotation because the tag alone has no repo. redisVersion tracks every update type;
      // postgresVersion is held to MAJOR-only by a packageRule below, so only a PG major (18 to 19) surfaces,
      // as its own reviewed PR.
      customType: "regex",
      description: "per-workload datastore image tags (annotated postgresVersion/redisVersion in workload values.yaml)",
      managerFilePatterns: ["/^argo_apps/workloads/charts/[^/]+/values\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=docker depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+(?:postgresVersion|redisVersion):\\s*\"?(?<currentValue>[\\w][\\w.-]*)\"?",
      ],
      datasourceTemplate: "docker",
    },
    {
      // pg-cluster's supported Postgres image map: one pinned <repo>:<tag>@<digest> per major. Digest-only,
      // per the packageRule below, so Renovate just refreshes each digest as the rolling tag moves.
      // Adding or removing a major is a manual edit: a new PG major is a pg_upgrade, not a digest swap.
      customType: "regex",
      description: "pg-cluster supported Postgres images (tag@digest per major)",
      managerFilePatterns: ["/^lib/helm/pg-cluster/files/postgres-images\\.yaml$/"],
      matchStrings: [
        "(?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>[\\w][\\w.-]*)@(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      datasourceTemplate: "docker",
    },
    {
      // Scalar vars in versions.env carrying a full `# renovate:` annotation. TALOS_IMAGE_RELEASE's
      // annotation also carries a `versioning=regex:...`, because its `-<build revision>` suffix would
      // otherwise read as a semver prerelease and be skipped as unstable.
      customType: "regex",
      description: "annotated version scalars in versions.env",
      managerFilePatterns: ["/^versions\\.env$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+\\w+=\"(?<currentValue>[^\"]+)\"",
      ],
    },
  ],

  packageRules: [
    {
      // ONE combined, auto-merged PR for every NON-major update, gated on the required CI checks.
      // WARNING: a merged bump reaches the LIVE cluster unattended via ArgoCD self-heal, including Cilium,
      // which can cut the cluster off its own network, and any local-path tag bump, which really needs a
      // manual re-vendor. It also bumps TALOS_IMAGE_RELEASE, which a merge does NOT apply: that still needs
      // 03e (and 03a for a reflash). Accepted for a hands-off homelab; to de-risk, add minimumReleaseAge or
      // drop automerge from the deps you want to gate.
      description: "combine all non-major updates into one auto-merged PR",
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "lockFileMaintenance"],
      groupName: "all non-major dependencies",
      automerge: true,
    },
    // MAJOR updates get their own PR each, which is Renovate's default, so no rule below does it. That keeps a
    // breaking bump reviewed in isolation. The VictoriaMetrics charts are the exception: their CRDs must match
    // the operator, so their majors stay in one PR.
    {
      description: "keep VictoriaMetrics majors together (CRDs must match the operator)",
      matchPackageNames: ["victoria-metrics-operator", "victoria-metrics-operator-crds", "victoria-metrics-k8s-stack", "victoria-logs-collector"],
      matchUpdateTypes: ["major"],
      groupName: "victoriametrics stack (major)",
    },
    {
      // k8s release tags are v-prefixed and the versions.env value is not, so strip the v when comparing.
      description: "kubernetes tags are v-prefixed",
      matchPackageNames: ["kubernetes/kubernetes"],
      extractVersion: "^v(?<version>.+)$",
    },
    {
      // local-path-provisioner ships as VENDORED upstream manifests keyed to values.image.tag, so a bump
      // must be re-diffed against the upstream release by hand. Labelled so you can split it out of the
      // combined PR and re-vendor before merging. busybox is its helper image, same treatment.
      description: "needs-revendor: local-path-provisioner",
      matchManagers: ["helm-values"],
      matchFileNames: ["argo_apps/platform/charts/02_local_path_provisioner/values.yaml"],
      addLabels: ["needs-revendor"],
    },
    {
      // Pin action refs to commit digests, so a moving tag cannot swap the action's code under us. The
      // semver-comment helper above keeps a readable version beside each digest.
      description: "pin github action refs to digests",
      matchManagers: ["github-actions"],
      pinDigests: true,
    },
    {
      // postgresVersion is a MAJOR selector only, a key into pg-cluster's image map, where the actual patch
      // and digest are pinned. Disabling patch/minor/digest here keeps the workload scalar from churning, so
      // only a MAJOR bump surfaces, as its own reviewed PR. That PR fails CI until the matching major is
      // added to files/postgres-images.yaml, which is the deliberate pg_upgrade gate.
      description: "workload postgresVersion: major-only (patch/minor come from the pg-cluster image map)",
      matchFileNames: ["argo_apps/workloads/charts/**/values.yaml"],
      matchDepNames: ["ghcr.io/cloudnative-pg/postgresql"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      enabled: false,
    },
    {
      // The image map is DIGEST-ONLY: each line stays on its major's rolling tag forever and Renovate just
      // refreshes the digest. Disabling tag bumps is what stops 18-minimal-trixie being rewritten to a 19 tag.
      description: "pg-cluster image map: digest-only, no tag version bumps",
      matchFileNames: ["lib/helm/pg-cluster/files/postgres-images.yaml"],
      matchUpdateTypes: ["major", "minor", "patch"],
      enabled: false,
    },
  ],
}
