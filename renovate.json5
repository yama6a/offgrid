{
  // Opens dependency-update PRs for every pin in the repo. Which manager owns what:
  //   helmv3          chart deps in Chart.yaml and Chart.lock
  //   helm-values     container images in values.yaml
  //   terraform       the aws provider in versions.tf and .terraform.lock.hcl
  //   github-actions  the action pins in the workflows
  //   customManagers  images in chart templates and shell scripts
  // The cron in .github/workflows/renovate.yaml sets the schedule, not an internal `schedule`, so a manual
  // workflow_dispatch works too. See docs/11_renovate.md.
  //
  // The shared preset holds the grouping, automerge and digest-pinning rules. Only rules specific to this
  // repo are below.
  // WARNING: the combined non-major PR automerges. Argo CD then applies a merged bump to the live cluster
  // unattended. That includes Cilium, which can cut the cluster off its own network. This is accepted for a
  // hands-off homelab. To gate a dependency, add minimumReleaseAge or remove automerge for it.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>yama6a/gha:default.json5"],

  // helmv3 finds every Chart.yaml and refreshes each wrapper's Chart.lock on a bump. file:// deps have no
  // datasource, so Renovate skips them.
  // helmUpdateSubChartArchives re-packs a vendored charts/*.tgz. No chart commits one, so it does nothing
  // unless one appears.
  // Never add a "**/charts/**" disable rule. The wrapper charts live under paths that contain /charts/, so
  // that rule would disable the whole repo.
  postUpdateOptions: ["helmUpdateSubChartArchives"],

  // Every `helm dependency update` sets Chart.lock's `generated:` to the current time. offgrid and
  // offgrid-private each run Renovate on the same charts. So one version bump lands with a different
  // `generated:` in each repo, and the next upstream sync conflicts on that line. Helm checks staleness by
  // `digest`, never by `generated`. A constant makes two runs on the same deps produce the same Chart.lock.
  // The command must match the allowed-commands input in .github/workflows/renovate.yaml. That allowlist,
  // not this file, lets Renovate run it.
  postUpgradeTasks: {
    commands: [
      'find . -name Chart.lock -exec sed -i \'s/^generated:.*/generated: "1970-01-01T00:00:00Z"/\' {} +',
    ],
    fileFilters: ["**/Chart.lock"],
    executionMode: "branch",
  },

  // A bump of this file re-vendors an upstream release manifest verbatim, with the curl recipe in its
  // README. A bot must never patch the image tag inside it.
  ignorePaths: ["argo_apps/platform/charts/03_barman_cloud_plugin/templates/**"],

  customManagers: [
    {
      // Images annotated `# renovate: datasource=docker` in files that helm-values cannot read: chart
      // templates and shell-script literals. helm-values or the next manager handle images in values.yaml,
      // so no image has two managers.
      // Captures repo:tag and the optional digest from the ref, so both the tag and the digest stay current.
      customType: "regex",
      description: "docker image refs (annotated) in chart templates and shell scripts",
      managerFilePatterns: [
        "/^lib/shell/.*\\.sh$/",
        "/^lib/helm/redis-instance/templates/redis\\.yaml$/", // the redis-exporter ref. Each workload sets its own server tag
        "/^argo_apps/platform/charts/07_redis_backup/templates/cronjob\\.yaml$/", // alpine/k8s + opstree-redis refs
      ],
      matchStrings: [
        "# renovate: datasource=docker(?: versioning=(?<versioning>\\S+))?\\s+[^\\n]*?(?<depName>[a-z0-9][a-z0-9._/-]+):(?<currentValue>[\\w][\\w.-]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?",
      ],
      datasourceTemplate: "docker",
    },
    {
      // A bare postgresVersion or redisVersion scalar in a workload's values.yaml. The depName= annotation
      // names the repo, because the tag alone has none. redisVersion takes every update type. A packageRule
      // below limits postgresVersion to majors, so only a Postgres major such as 18 to 19 opens a PR.
      customType: "regex",
      description: "per-workload datastore image tags (annotated postgresVersion/redisVersion in workload values.yaml)",
      managerFilePatterns: ["/^argo_apps/workloads/charts/[^/]+/values\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=docker depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+(?:postgresVersion|redisVersion):\\s*\"?(?<currentValue>[\\w][\\w.-]*)\"?",
      ],
      datasourceTemplate: "docker",
    },
    {
      // pg-cluster's map of supported Postgres images, one pinned <repo>:<tag>@<digest> per major. A
      // packageRule below allows digest updates only, so Renovate refreshes each digest as the tag moves.
      // Adding or removing a major is a manual edit, because a new Postgres major needs a pg_upgrade.
      customType: "regex",
      description: "pg-cluster supported Postgres images (tag@digest per major)",
      managerFilePatterns: ["/^lib/helm/pg-cluster/files/postgres-images\\.yaml$/"],
      matchStrings: [
        "(?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>[\\w][\\w.-]*)@(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      datasourceTemplate: "docker",
    },
  ],

  packageRules: [
    // Each major update gets its own PR, which is Renovate's default. The VictoriaMetrics charts are the
    // exception. Their CRDs must match the operator, so their majors share one PR.
    {
      description: "keep VictoriaMetrics majors together (CRDs must match the operator)",
      matchPackageNames: ["victoria-metrics-operator", "victoria-metrics-operator-crds", "victoria-metrics-k8s-stack", "victoria-logs-collector"],
      matchUpdateTypes: ["major"],
      groupName: "victoriametrics stack (major)",
    },
    {
      // postgresVersion only selects a major. It is a key into pg-cluster's image map, which pins the patch
      // and digest. With minor, patch and digest updates off, only a major bump opens a PR. That PR fails CI
      // until files/postgres-images.yaml has the new major. This is the intended gate before a pg_upgrade.
      description: "workload postgresVersion: major-only (patch/minor come from the pg-cluster image map)",
      matchFileNames: ["argo_apps/workloads/charts/**/values.yaml"],
      matchDepNames: ["ghcr.io/cloudnative-pg/postgresql"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      enabled: false,
    },
    {
      // The image map takes digest updates only. Each line stays on its major's rolling tag, and Renovate
      // refreshes the digest. With tag bumps off, Renovate cannot rewrite 18-minimal-trixie to a 19 tag.
      description: "pg-cluster image map: digest-only, no tag version bumps",
      matchFileNames: ["lib/helm/pg-cluster/files/postgres-images.yaml"],
      matchUpdateTypes: ["major", "minor", "patch"],
      enabled: false,
    },
  ],
}
